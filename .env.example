# ==============================================================================
# PICC-PP-NNP-DMS-Management - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# Do NOT commit '.env' or real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port on which the Spring Boot microservice listens (Default: 8080)
SERVER_PORT=8080

# Servlet context path prefix for REST endpoints (Default: /api/dms)
SERVER_SERVLET_CONTEXT_PATH=/api/dms

# Active Spring Profile (e.g., local, dev, main)
SPRING_PROFILES_ACTIVE=local

# Spring Cloud Config Label
CONFIG_LABEL=v1

# Centralized Spring Cloud Config Server URL (Optional)
CONFIG_SERVER_URL=http://localhost:8888

# ------------------------------------------------------------------------------
# 2. Git Repository Configuration (DMS Deployment Scripts)
# ------------------------------------------------------------------------------
# HTTPS clone URL for the DMS deployment repository
GIT_REPOSITORY_URL=https://gitlab.example.com/bigdata-management/deployment/dms-deploy-script.git

# Target Git branch to checkout on remote target host
GIT_REPOSITORY_BRANCH=main

# Git authentication credentials for remote VM clone
GIT_REPOSITORY_USERNAME=devops
GIT_REPOSITORY_TOKEN=yourPersonalAccessTokenOrSecretHere

# ------------------------------------------------------------------------------
# 3. Database / Persistence Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# JDBC Connection URL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nnp-core-comp

# PostgreSQL Authentication
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=yourSecretPostgresPasswordHere

# Hibernate DDL Auto (update, validate, none)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Database Default Schema
SPRING_JPA_DEFAULT_SCHEMA=portal

# ------------------------------------------------------------------------------
# 4. DMS Remote VM Execution & Health Monitoring
# ------------------------------------------------------------------------------
# Default port probed by DMS health checks on remote target VMs (Default: 9099)
DEPLOYMENT_HEALTH_PORT=9099

# Disk usage threshold alert percentage (Default: 80)
DEPLOYMENT_DISK_THRESHOLD=80

# Cron expression for background health checks (Default: every 5 minutes)
DEPLOYMENT_SCHEDULER_CRON=0 */5 * * * *

# In-memory SSH key cache TTL in minutes before requiring re-authentication (Default: 60)
DMS_SSH_KEY_TTL_MINUTES=60

# Fixed delay in milliseconds for purging expired SSH keys from memory (Default: 60000)
DMS_SSH_KEY_PURGE_DELAY_MS=60000

# SSH connection timeout in milliseconds (Default: 10000)
DMS_SSH_CONNECT_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 5. Logging & Diagnostics
# ------------------------------------------------------------------------------
# Microservice logging level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
